# Copy to .env.local (git-ignored) and fill in what you use.
# NEVER commit real values. NEVER prefix a secret with NEXT_PUBLIC_ — anything
# NEXT_PUBLIC_* is shipped to every browser. `npm run check:secrets` enforces this.
# Unset integrations show as NOT CONFIGURED / DISCONNECTED in Settings; nothing
# pretends to work without its credentials.

# ── Supabase (required) ─────────────────────────────────────────────────────
# Dashboard → Project Settings → API. The anon key is public by design (RLS
# protects data). The service-role key bypasses RLS: server only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Used by the legacy ops agent scripts (same values as above).
SUPABASE_URL=https://your-project-ref.supabase.co

# Public base URL, used for magic-link redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Access control ──────────────────────────────────────────────────────────
# V1 single owner: comma-separated emails allowed to sign in. Accounts are only
# auto-created for these emails. Leave empty to allow existing Supabase users only.
AUTH_ALLOWED_EMAILS=
# Emails granted access to /ops (legacy Pantheon operations). Server-side only.
OPS_ADMIN_EMAILS=

# ── Agents (all OFF by default) ─────────────────────────────────────────────
# Character agents (new engine). Must be exactly "true" to run.
AGENTS_ENABLED=false
# Legacy ops agents (god-agent, ruflo-runner, …). Set in the PROCESS environment
# (shell or PM2), not only here, to start them. See docs/AGENT_PERMISSIONS.md.
OPS_AGENTS_ENABLED=false
# Allow ops agents to edit legacy /ops UI files (components/*.tsx, app/(os)/ops).
OPS_AGENT_CODE_WRITES=false

# ── Secrets vault ───────────────────────────────────────────────────────────
# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts social OAuth
# tokens at rest. Rotating it requires re-encrypting stored credentials.
CREDENTIALS_ENCRYPTION_KEY=
# Shared secret for scheduled job endpoints (fail closed when unset).
CRON_SECRET=

# ── AI providers ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Image / video generation (provider of your choice).
IMAGE_GENERATION_PROVIDER=
IMAGE_GENERATION_API_KEY=
VIDEO_GENERATION_PROVIDER=
VIDEO_GENERATION_API_KEY=

# ── Social platforms (app credentials; accounts connect via OAuth later) ────
# Instagram via Meta: needs a Business/Creator account + app review.
META_APP_ID=
META_APP_SECRET=
# TikTok Content Posting API: needs an app audit for public posting.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# YouTube via Google Cloud: unverified projects upload private videos only.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# X: write access depends on your API tier.
X_CLIENT_ID=
X_CLIENT_SECRET=

# ── Payments / email ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=

# ── Webhooks (disabled unless set) ──────────────────────────────────────────
GITHUB_WEBHOOK_SECRET=
GENERIC_WEBHOOK_TOKEN=
