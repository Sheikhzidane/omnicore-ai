# Omnicore — environment variables.
# Local: copy to .env.local (git-ignored) and fill in what you use.
# Vercel: Project → Settings → Environment Variables (never commit real values).
# NEVER prefix a secret with NEXT_PUBLIC_ — anything NEXT_PUBLIC_* ships to every
# browser. `npm run check:secrets` enforces this. Full matrix: docs/ENVIRONMENT.md.
# Anything unset shows as NOT CONFIGURED in Settings; nothing pretends to work.

# ── Core (required) ─────────────────────────────────────────────────────────
# Supabase → Project Settings → API. The anon key is public by design (RLS).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key bypasses RLS: server only, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Same value as NEXT_PUBLIC_SUPABASE_URL (used by server code and legacy scripts).
SUPABASE_URL=https://your-project-ref.supabase.co
# Public base URL (magic links, OAuth redirect URIs). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Access control (required) ───────────────────────────────────────────────
# Comma-separated emails allowed to sign in. There is no public sign-up.
AUTH_ALLOWED_EMAILS=
# Emails granted the legacy /ops dashboard (optional).
OPS_ADMIN_EMAILS=

# ── Security (required for social accounts and scheduling) ──────────────────
# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts OAuth tokens.
CREDENTIALS_ENCRYPTION_KEY=
# 32+ random characters: `openssl rand -hex 32`. Vercel Cron sends it as a bearer token.
CRON_SECRET=

# ── Agents (off by default) ─────────────────────────────────────────────────
# Global kill switch. Must be exactly "true" for any agent to run.
AGENTS_ENABLED=false

# ── AI providers ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Optional overrides (defaults: claude-opus-5 / claude-haiku-4-5).
ANTHROPIC_MODEL=
ANTHROPIC_FAST_MODEL=
OPENAI_API_KEY=
# Required only if AI_TEXT_PROVIDER=openai.
OPENAI_TEXT_MODEL=
OPENAI_FAST_TEXT_MODEL=
# Optional overrides (defaults: gpt-image-1, sora-2, omni-moderation-latest, text-embedding-3-small).
OPENAI_IMAGE_MODEL=
OPENAI_VIDEO_MODEL=
OPENAI_MODERATION_MODEL=
OPENAI_EMBEDDING_MODEL=
# Provider selection; blank = sensible defaults (docs/AI_PROVIDERS.md).
AI_TEXT_PROVIDER=
AI_IMAGE_PROVIDER=
AI_VIDEO_PROVIDER=
AI_MODERATION_PROVIDER=
AI_EMBEDDING_PROVIDER=
# "mock" = labelled fake outputs for local development. Refused in production.
AI_PROVIDER_MODE=

# ── Social platforms (app credentials; accounts connect via OAuth) ──────────
# Instagram (Meta app, Instagram API with Instagram Login).
META_APP_ID=
META_APP_SECRET=
# Any random string; paste the same value into the Meta webhook settings.
META_WEBHOOK_VERIFY_TOKEN=
# TikTok (Login Kit + Content Posting API).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Keep SELF_ONLY until TikTok has audited your app.
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
# YouTube (Google Cloud OAuth client, YouTube Data API v3).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# private | unlisted | public. Unverified Google projects are forced private.
YOUTUBE_PRIVACY_STATUS=private
# X (OAuth 2.0 client).
X_CLIENT_ID=
X_CLIENT_SECRET=
# Only for Account Activity webhooks (the app's API key secret).
X_CONSUMER_SECRET=

# ── Payments / email (optional) ─────────────────────────────────────────────
# Stripe webhook signing secret (whsec_…) for /api/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=
# Resend: sends outreach emails only after a human approves each one.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. partnerships@yourdomain.com
OUTREACH_FROM_EMAIL=

# ── Legacy /ops dashboard (optional; see docs/ENVIRONMENT.md) ───────────────
OPS_AGENTS_ENABLED=false
OPS_AGENT_CODE_WRITES=false
GITHUB_WEBHOOK_SECRET=
GENERIC_WEBHOOK_TOKEN=
