{
  "name": "task-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "agents": "node scripts/ruflo-runner.mjs",
    "orchestrator": "node scripts/orchestrator.mjs",
    "assign": "node scripts/assign-agent.mjs",
    "briefing": "node scripts/daily-briefing.mjs",
    "digest": "node scripts/weekly-digest.mjs",
    "start:all": "pm2 start ecosystem.config.cjs",
    "test": "node --test \"scripts/god/*.test.mjs\" && node scripts/blocklist.test.mjs && node --conditions=react-server --import tsx --test \"tests/**/*.test.mjs\" \"tests/**/*.test.ts\"",
    "test:watch": "node --test --watch scripts/god/*.test.mjs",
    "test:db": "node -e \"if(!process.env.TEST_DATABASE_URL){console.error(\\\"TEST_DATABASE_URL is required (disposable Postgres only)\\\");process.exit(1)}\" && node --test \"tests/db/*.test.mjs\"",
    "check:secrets": "node scripts/check-env-exposure.mjs --require-build",
    "db:types": "node scripts/generate-db-types.mjs",
    "check:committed-secrets": "node scripts/scan-committed-secrets.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "libsodium-wrappers": "^0.8.3",
    "lucide-react": "^1.8.0",
    "msedge-tts": "^2.0.5",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.28.1",
    "server-only": "^0.0.1",
    "stripe": "^22.0.2",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "pg": "^8.23.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
